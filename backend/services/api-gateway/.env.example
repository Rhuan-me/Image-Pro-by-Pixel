NODE_ENV=development
PORT=8000
LOG_LEVEL=dev

# Em produção, informe origens explícitas separadas por vírgula; não use * com credenciais.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

AUTH_SERVICE_URL=http://localhost:3001
PROJECT_SERVICE_URL=http://localhost:3002
IMAGE_SERVICE_URL=http://localhost:3003
PROXY_TIMEOUT_MS=30000
JSON_LIMIT=1mb

# Redis local. Em Docker, REDIS_URL é definido pelo Compose.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=pixpro:gateway:rl:
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20

# JWT: escolha uma opção. JWT habilitado por padrão para rotas protegidas.
JWT_ENABLED=true
JWT_ALGORITHMS=HS256
JWT_SECRET=9OIO4sUpcFBu52TfMIg-_aiPci1KOJtmTPQaQDSreV0
JWT_ISSUER=pixpro-auth-service
JWT_AUDIENCE=pixpro-api

PUBLIC_AUTH_PATHS=/api/auth/register,/api/auth/login,/api/v1/auth/login,/api/v1/auth/register,/api/v1/auth/forgot-password,/api/v1/auth/refresh