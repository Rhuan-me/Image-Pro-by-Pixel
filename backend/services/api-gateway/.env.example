# Porta do API Gateway
PORT=8000

# Ambiente de execução (development | test | production)
NODE_ENV=development

# Origens permitidas para requisições CORS (separadas por vírgula ou '*' para livre)
CORS_ORIGIN=*

# Nível e formato de log HTTP (dev | combined | common | short | tiny)
LOG_FORMAT=dev

# Timeout padrão para requisições de proxy (em milissegundos)
PROXY_TIMEOUT=30000


# URLs dos Microsserviços Downstream

# Microsserviço de Autenticação e Autorização
AUTH_SERVICE_URL=http://localhost:3001

# Microsserviço de Gerenciamento de Projetos e Ativos
PROJECT_SERVICE_URL=http://localhost:3002

# Microsserviço de Processamento de Imagens
IMAGE_PROCESSING_SERVICE_URL=http://localhost:3003
