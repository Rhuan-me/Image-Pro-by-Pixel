{
  "info": {
    "_postman_id": "366300d0-6a67-4d67-b2f0-f2ba14cc1044",
    "name": "PixPro — API Gateway & Auth Service",
    "description": "Coleção de testes para validação do API Gateway e dos endpoints de autenticação e observabilidade do ecossistema PixPro.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "51332348",
    "_collection_link": "https://go.postman.co/collection/51332348-366300d0-6a67-4d67-b2f0-f2ba14cc1044?source=collection_link"
  },
  "item": [
    {
      "name": "01. Observabilidade Gateway",
      "item": [
        {
          "name": "Health Check Gateway",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/health",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Verifica se o API Gateway está saudável, retornando uptime e catálogo de serviços downstream configurados."
          },
          "response": []
        },
        {
          "name": "Liveness Probe (Kubernetes/Docker)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/live",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "live"
              ]
            },
            "description": "Probe leve para orquestradores de container checarem vida do processo."
          },
          "response": []
        },
        {
          "name": "Health Check Auth Service (via Gateway Proxy)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/health",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "health"
              ]
            },
            "description": "Verifica a saúde do Auth Service downstream através do proxy reverso do Gateway."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02. Autenticação (CU01 & CU02)",
      "item": [
        {
          "name": "CU01 — Cadastro de Usuário (Register)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rhuan Desenvolvedor\",\n  \"email\": \"rhuan@pixpro.com\",\n  \"password\": \"SenhaForte@2026\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/register",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Cadastra um novo usuário no sistema PixPro. Espera HTTP 201 Created."
          },
          "response": []
        },
        {
          "name": "CU01 — Cadastro com Erro de Validação (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sem Email Nem Senha\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/register",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Valida tratamento de erro 400 quando campos obrigatórios não são informados."
          },
          "response": []
        },
        {
          "name": "CU02 — Login de Usuário (Obter Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "    console.log('Token JWT capturado automaticamente:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rhuan@pixpro.com\",\n  \"password\": \"SenhaForte@2026\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Autentica usuário e retorna tokens JWT e refreshToken. O token é salvo na variável de coleção 'jwt_token'."
          },
          "response": []
        },
        {
          "name": "CU02 — Consulta de Sessão / Perfil (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "postman-manual-trace-001"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/me",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Consulta os dados da sessão do usuário autenticado enviando o token JWT e um Correlation ID customizado."
          },
          "response": []
        },
        {
          "name": "CU02 — Acesso Não Autorizado Sem Token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/me",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Valida retorno 401 Unauthorized quando requisição é feita sem Authorization header."
          },
          "response": []
        },
        {
          "name": "Preservação de Query Params Transparentemente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/me?filter=active&page=1&limit=10",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ],
              "query": [
                {
                  "key": "filter",
                  "value": "active"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Testa se query parameters são repassados integralmente sem distorção pelo Gateway."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03. Testes de Resiliência & Tratamento de Erros",
      "item": [
        {
          "name": "Rota Não Encontrada no Gateway (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/rota-que-nao-existe",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "rota-que-nao-existe"
              ]
            },
            "description": "Testa se o Gateway responde com payload de erro padronizado RFC 7807 e código 404 NOT_FOUND."
          },
          "response": []
        },
        {
          "name": "Simulação Downstream Indisponível (503)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"falso@pixpro.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Execute esta requisição com o Auth Service desligado (porta 3001 inativa) para observar o Gateway retornando HTTP 503 SERVICE_UNAVAILABLE padronizado."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "jwt_token",
      "value": ""
    }
  ]
}