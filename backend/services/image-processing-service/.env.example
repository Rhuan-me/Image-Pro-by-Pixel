PORT=3003
NODE_ENV=development
LOG_LEVEL=dev

# RabbitMQ Event Bus
RABBITMQ_URL=amqp://pixpro:dev-rabbit-password@localhost:5672
RABBITMQ_EXCHANGE=pixpro.events
RABBITMQ_QUEUE=image-queue
RABBITMQ_ROUTING_KEY=image.uploaded

# PostgreSQL
DATABASE_URL=postgres://pixpro:dev-postgres-password@localhost:5432/pixpro

# Upload & Simulação de Storage
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
STORAGE_BASE_PATH=/storage/raw
