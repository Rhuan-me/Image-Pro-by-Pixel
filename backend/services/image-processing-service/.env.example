PORT=3003
NODE_ENV=development
LOG_LEVEL=dev

# RabbitMQ Event Bus
RABBITMQ_URL=amqp://pixpro:dev-rabbit-password@localhost:5672
RABBITMQ_EXCHANGE=pixpro.events
RABBITMQ_QUEUE=image-queue
RABBITMQ_ROUTING_KEY=image.uploaded

# PostgreSQL
DATABASE_URL=postgres://pixpro:dev-postgres-password@localhost:5432/pixpro

# Upload & Armazenamento Local
MAX_FILE_SIZE_MB=5
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
STORAGE_BASE_PATH=/storage/raw

# S3 Local Storage (SeaweedFS / MinIO)
S3_ENDPOINT=http://localhost:9000
MINIO_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=anykey
AWS_SECRET_ACCESS_KEY=anysecret
S3_BUCKET=pixpro-storage
S3_REGION=us-east-1
