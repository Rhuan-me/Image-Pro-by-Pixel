{
  "name": "@pixpro/image-processing-service",
  "version": "1.0.0",
  "private": true,
  "description": "Microsserviço de processamento assíncrono de imagens do PixPro",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
