NODE_ENV=development
PORT=4000
INSTANCE_ID=notification-service-1
LOG_LEVEL=dev

CORS_ORIGINS=https://localhost:5173,https://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001

RABBITMQ_URL=amqp://pixpro:dev-rabbit-password@localhost:5672
RABBITMQ_EXCHANGE=pixpro.events
RABBITMQ_QUEUE=image-queue
RABBITMQ_ROUTING_KEY=image.uploaded

REDIS_URL=redis://:dev-redis-password@localhost:6379
REDIS_BACKPLANE_CHANNEL=pixpro:notifications:backplane
REDIS_KEY_PREFIX=pixpro:notification:rl:
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20

JWT_ENABLED=true
JWT_ALGORITHMS=HS256
JWT_SECRET=9OIO4sUpcFBu52TfMIg-_aiPci1KOJtmTPQaQDSreV0
JWT_ISSUER=pixpro-auth-service
JWT_AUDIENCE=pixpro-api
JWT_REVOKED_PREFIX=pixpro:auth:revoked:

PUBLIC_AUTH_PATHS=
