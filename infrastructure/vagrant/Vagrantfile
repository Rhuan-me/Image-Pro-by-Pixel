Vagrant.configure("2") do |config|
    # Ubuntu 22.04 LTS
    config.vm.box = "ubuntu/jammy64" 

    # Configuração do nó Manager
    config.vm.define "manager" do |manager|
        manager.vm.hostname = "manager"
        manager.vm.network "private_network", ip: "192.168.56.10"
        manager.vm.provider "virtualbox" do |vb|
        vb.memory = 1024
        vb.cpus = 1
        end
        # Inicializa o Swarm e salva o token de join em um arquivo compartilhado
        manager.vm.provision "shell", inline: <<-SHELL
        echo "=== Configurando Docker e Ansible no Manager ==="
        apt-get update && apt-get install -y docker.io ansible
        usermod -aG docker vagrant
        
        echo "=== Inicializando o Docker Swarm ==="
        docker swarm init --advertise-addr 192.168.56.10
        docker swarm join-token worker -q > /vagrant/worker_token.txt
        SHELL
    end

    # Configuração do Nó Worker
    config.vm.define "worker" do |worker|
        worker.vm.hostname = "worker"
        worker.vm.network "private_network", ip: "192.168.56.11"
        worker.vm.provider "virtualbox" do |vb|
        vb.memory = 1024
        vb.cpus = 1
        end
        # Instala o Docker e entra no cluster Swarm usando o token gerado pelo Manager
        worker.vm.provision "shell", inline: <<-SHELL
        echo "=== Configurando Docker no Worker ==="
        apt-get update && apt-get install -y docker.io
        usermod -aG docker vagrant
        
        while [ ! -f /vagrant/worker_token.txt ]; do
            sleep 2
        done
        
        TOKEN=$(cat /vagrant/worker_token.txt)
        echo "=== Entrando no Cluster Swarm ==="
        docker swarm join --token $TOKEN 192.168.56.10:2377
        SHELL
    end
end